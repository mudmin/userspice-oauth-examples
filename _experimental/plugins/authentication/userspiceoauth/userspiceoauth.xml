<?xml version="1.0" encoding="utf-8"?>
<extension version="3.1" type="plugin" group="authentication" method="upgrade">
    <name>plg_authentication_userspiceoauth</name>
    <author>UserSpice OAuth Integrator (AI)</author>
    <creationDate>October 2023</creationDate>
    <copyright>Copyright (C) 2023 All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>userspice@example.com</authorEmail>
    <authorUrl>www.userspice.com</authorUrl>
    <version>1.0.0</version>
    <description>PLG_AUTHENTICATION_USERSPICEOAUTH_XML_DESCRIPTION</description>

    <files>
        <filename plugin="userspiceoauth">userspiceoauth.php</filename>
        <filename>index.html</filename>
        <folder>language</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.plg_authentication_userspiceoauth.ini</language>
        <language tag="en-GB">en-GB/en-GB.plg_authentication_userspiceoauth.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_AUTHENTICATION_USERSPICEOAUTH_CONFIG_LABEL">
                <field name="userspice_server_url" type="text"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_SERVER_URL_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_SERVER_URL_DESC"
                    default="https://your-userspice-server.com/usersc/"
                    filter="url"
                    size="50"
                />
                <field name="client_id" type="text"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_CLIENT_ID_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_CLIENT_ID_DESC"
                    default=""
                    size="50"
                />
                <field name="client_secret" type="password"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_CLIENT_SECRET_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_CLIENT_SECRET_DESC"
                    default=""
                    size="50"
                />
                <field name="us_auth_endpoint_path" type="text"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_AUTH_ENDPOINT_PATH_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_AUTH_ENDPOINT_PATH_DESC"
                    default="plugins/oauth_server/auth.php"
                    size="50"
                />
                <field name="us_token_endpoint_path" type="text"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_TOKEN_ENDPOINT_PATH_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_TOKEN_ENDPOINT_PATH_DESC"
                    default="plugins/oauth_server/auth.php"
                    size="50"
                />
                 <field name="us_userinfo_endpoint_path" type="text"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_USERINFO_ENDPOINT_PATH_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_USERINFO_ENDPOINT_PATH_DESC"
                    default="plugins/oauth_server/api.php"
                    size="50"
                />
                <field name="scope" type="text"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_SCOPE_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_SCOPE_DESC"
                    default="profile email"
                    size="50"
                />
                <field name="create_joomla_user" type="radio"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_CREATE_USER_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_CREATE_USER_DESC"
                    class="btn-group btn-group-yesno"
                    default="1">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field name="default_user_group" type="usergroup"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_DEFAULT_GROUP_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_DEFAULT_GROUP_DESC"
                    default="2"
                />
                <field name="custom_redirect_button_text" type="text"
                    label="PLG_AUTHENTICATION_USERSPICEOAUTH_BUTTON_TEXT_LABEL"
                    description="PLG_AUTHENTICATION_USERSPICEOAUTH_BUTTON_TEXT_DESC"
                    default="Login with UserSpice"
                    size="30"
                />
            </fieldset>
        </fields>
    </config>
</extension>
